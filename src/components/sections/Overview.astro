---
import { Image } from 'astro:assets';
import media from '../../content/solana-east.media.js';
import { getSection, formatNumber, sourceList, splitTail } from '../../lib/content.js';

const section = getSection('project-overview');
const facts = section.content.facts;
const fact = (label: string) => facts.find((f: any) => f.label === label);

const land = fact('Land area');
const units = fact('Number of units');
const mix = fact('Residential product mix');
const developer = fact('Developer');
const place = fact('Project location');

const figures = [
  { value: formatNumber(land.value), unit: land.unit, detail: `${formatNumber(land.alternateValue)} m² of land`, starred: false },
  { value: formatNumber(units.value), unit: units.unit, detail: 'Homes in the masterplan', starred: false },
  {
    value: `${mix.value.singleFamilyPercent}/${mix.value.multipleFamilyPercent}`,
    unit: '%',
    detail: 'Single- / multiple-family mix',
    starred: true,
  },
];

const { lead, tail } = splitTail(section.content.heading, 2);
const main = media.buildingA2;
const inset = media.livingRoom;
---

<section id="project-overview" class="section rule-top overflow-hidden" aria-labelledby="overview-title">
  <div class="container-x grid items-center gap-x-12 gap-y-16 lg:grid-cols-12">
    <div class="lg:col-span-6 lg:order-2">
      <p class="eyebrow" data-reveal>{section.title}</p>
      <h2 id="overview-title" class="heading-2 mt-4" data-reveal style="--reveal-delay:80">
        {lead} <span class="t-red">{tail}</span>
      </h2>
      <p class="lead mt-7" data-reveal style="--reveal-delay:140">{section.content.description}</p>
      <p class="mt-5 text-[0.95rem] text-ash-400" data-reveal style="--reveal-delay:180">
        Developed by <strong class="font-semibold text-bone-50">{developer.value}</strong> in {place.value}.
      </p>

      <dl class="mt-10 grid grid-cols-1 gap-y-6 sm:grid-cols-3" data-reveal style="--reveal-delay:220">
        {
          figures.map((figure) => (
            <div class="border-l border-crimson-600 pl-5">
              <dt class="sr-only">{figure.unit}: {figure.detail}</dt>
              <dd>
                <span class="numeral block text-[clamp(2.25rem,1.6rem+1.6vw,3.25rem)] whitespace-nowrap">
                  {figure.value}{figure.starred && <sup aria-hidden="true" class="text-[0.4em]">*</sup>}
                </span>
                <span class="label mt-2 block text-crimson-400" aria-hidden="true">{figure.unit}</span>
                <span class="meta mt-1 block text-xs" aria-hidden="true">{figure.detail}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="source-note mt-8" data-reveal>
        Source: {sourceList(land.sourceIds)}. <span aria-hidden="true">*</span>Product-mix percentages are read from a brochure
        graphic and are pending confirmation.
      </p>
    </div>

    <div class="relative pb-[16%] lg:col-span-6 lg:order-1 lg:pb-[12%]">
      <span class="absolute top-[8%] -left-[10%] aspect-square w-[62%] rounded-full bg-crimson-600" aria-hidden="true"></span>
      <div class="tone zoom group relative ml-[8%] aspect-[4/5] w-[78%] overflow-hidden rounded-t-[999px] bg-ink-850 sm:aspect-[5/6]" data-reveal="image">
        <Image
          src={main.src}
          alt={main.alt}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 64rem) 36vw, 70vw"
          quality={62}
          class="media-fill"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-900/70 via-transparent to-transparent" aria-hidden="true"></div>
      </div>
      <div class="shape-circle tone zoom group absolute right-0 bottom-0 w-[42%] border-[6px] border-ink-900 bg-ink-850 sm:right-[4%]" data-reveal="scale" style="--reveal-delay:200">
        <Image src={inset.src} alt={inset.alt} widths={[320, 480, 640]} sizes="(min-width: 64rem) 16vw, 36vw" quality={62} class="media-fill" />
      </div>
    </div>
  </div>
</section>
