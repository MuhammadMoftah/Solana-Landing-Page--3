---
import InquiryForm from '../contact/InquiryForm.vue';
import Icon from '../ui/Icon.astro';
import { content, getSection, sourceList, digitsOnly, splitTail } from '../../lib/content.js';

const section = getSection('contact');
const units = getSection('residential-units');
const { thirdPartyContact } = section.content;
const phoneDigits = digitsOnly(thirdPartyContact.phone);
const unitTypes = units.content.unitTypes.map((unit: any) => unit.name);
const { lead, tail } = splitTail(section.content.heading, 2);
---

<section id="contact" class="section rule-top overflow-hidden" aria-labelledby="contact-title">
  <span class="pointer-events-none absolute -top-32 -left-40 aspect-square w-[28rem] rounded-full bg-crimson-600/15" aria-hidden="true"></span>

  <div class="container-x relative grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <p class="eyebrow" data-reveal>{section.title}</p>
      <h2 id="contact-title" class="heading-2 mt-4 text-[clamp(2.75rem,1.5rem+4.4vw,5.5rem)]" data-reveal style="--reveal-delay:80">
        {lead} <span class="t-red">{tail}.</span>
      </h2>
      <p class="lead mt-7" data-reveal style="--reveal-delay:140">{section.content.description}</p>

      <div class="mt-10 border-t border-white/12 pt-8" data-reveal style="--reveal-delay:180">
        <p class="label">Call or WhatsApp</p>
        <a href={`tel:+${phoneDigits}`} class="mt-3 inline-flex items-center gap-3 font-display text-[clamp(1.75rem,1.4rem+1.2vw,2.5rem)] leading-none text-bone-50 transition-colors hover:text-crimson-300">
          <Icon name="phone" class="size-6 text-crimson-400" />
          {thirdPartyContact.phone}
        </a>
        <p class="source-note mt-3 max-w-xs">
          Published by the {sourceList(thirdPartyContact.sourceIds)} — not verified as an official ORA sales channel.
        </p>
      </div>
    </div>

    <div class="lg:col-span-7" data-reveal="fade">
      <InquiryForm
        client:visible
        fields={section.content.formFields}
        unitTypes={unitTypes}
        whatsappNumber={phoneDigits}
        projectName={content.project.displayName}
        disclaimer={section.content.disclaimer}
      />
      <noscript>
        <p class="text-ash-300">
          The enquiry form needs JavaScript. You can call
          <a class="text-link" href={`tel:+${phoneDigits}`}>{thirdPartyContact.phone}</a> or message on
          <a class="text-link" href={`https://wa.me/${phoneDigits}`}>WhatsApp</a>.
        </p>
      </noscript>
    </div>
  </div>
</section>
