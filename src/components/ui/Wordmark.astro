---
/** Typographic Solana East wordmark (no official project logo exists yet). */
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;
const sizes = {
  sm: 'text-[1.25rem]',
  md: 'text-[1.6rem]',
  lg: 'text-[2.75rem]',
};
---

<span class:list={['inline-flex items-baseline gap-2.5 leading-none', className]}>
  <span class:list={['font-display tracking-[0.02em] whitespace-nowrap text-bone-50 uppercase', sizes[size]]}>Solana East<span class="text-crimson-500" aria-hidden="true">.</span></span>{' '}
  <span class="text-[0.625rem] font-semibold tracking-[0.3em] text-ash-400 uppercase">by ORA</span>
</span>
